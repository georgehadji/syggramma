# Syggramma configuration — copy to .env and fill in secrets
# cp .env.example .env

# ── General ──────────────────────────────────────────────────────────
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────
DB_URL=postgresql+psycopg://syggramma:syggramma@localhost:5432/syggramma
DB_ECHO=false

# ── Eudoxus API ──────────────────────────────────────────────────────
EUDOXUS_BASE_URL=https://service.eudoxus.gr/coursebooks/rest/
EUDOXUS_MAX_RPS=2.0
EUDOXUS_MAX_CONCURRENT=4
EUDOXUS_USER_AGENT=Syggramma/0.1 (mailto:vivlosbooks@gmail.com)

# ── External APIs ────────────────────────────────────────────────────
OPENALEX_BASE_URL=https://api.openalex.org/
OPENALEX_MAX_RPS=10.0
OPENALEX_MAILTO=vivlosbooks@gmail.com

ORCID_BASE_URL=https://pub.orcid.org/v3.0/
ORCID_MAX_RPS=5.0

CROSSREF_BASE_URL=https://api.crossref.org/
CROSSREF_MAX_RPS=5.0

# ── LLM providers (tried in order: Anthropic → OpenRouter → Grok) ──────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# T1: Claude Sonnet 5 ($12/Mtok) — best Greek quality
# T2: Gemini 2.5 Flash ($3/Mtok) — excellent multilingual
# T3: DeepSeek V4 Pro ($1/Mtok) — best value
# T4: Gemini 2.5 Flash Lite (free)
OPENROUTER_API_KEY=
OPENROUTER_TIER1_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TIER2_MODEL=google/gemini-2.5-flash
OPENROUTER_TIER3_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_TIER4_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_TOKENS=4096

GROK_API_KEY=
GROK_MODEL=x-ai/grok-4.5
GROK_MAX_TOKENS=4096

# ── SMTP / Mail ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=noreply@kyriakidis.gr
MAIL_FROM_NAME=Εκδόσεις Κυριακίδη

# ── Outreach ─────────────────────────────────────────────────────────
OUTREACH_MAX_PER_DAY=50
OUTREACH_QUIET_PERIOD_DAYS=90
OUTREACH_DEFAULT_LEGAL_BASIS=GDPR Art. 6(1)(f) — Legitimate Interest
OUTREACH_LIA_DOCUMENT_REF=

# ── Encryption ────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Harvest ──────────────────────────────────────────────────────────
HARVEST_START_YEAR=2024
HARVEST_END_YEAR=2025
# HARVEST_PILOT_DEPARTMENTS=2845,1234,5678
